#install -m 0644 %{SOURCE15} $RPM_BUILD_ROOT%{_datadir}/doc/kernel-keys/%{specversion}-%{pkgrelease}/kernel-signing-ca-20200609.cer
#ln -s kernel-signing-ca-20200609.cer $RPM_BUILD_ROOT%{_datadir}/doc/kernel-keys/%{specversion}-%{pkgrelease}/kernel-signing-ca.cer
