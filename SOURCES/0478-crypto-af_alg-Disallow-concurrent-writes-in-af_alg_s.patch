From 3f065375d46dcbc790e009c61cfdac0d9dde43ed Mon Sep 17 00:00:00 2001
From: Brett Mastbergen <bmastbergen@ciq.com>
Date: Tue, 22 Sep 2026 15:04:39 -0400
Subject: [PATCH] crypto: af_alg - Disallow concurrent writes in af_alg_sendmsg

jira VULN-158636
cve CVE-2025-39964
commit-author Herbert Xu <herbert@gondor.apana.org.au>
commit 1b34cbbf4f011a121ef7b2d7d6e6920a036d5285
upstream-diff context diff: this kernel's af_alg_ctx predates the
  ctx->init state machine of the 2020 AF_ALG rework (f3c802a1f3001
  and follow-ups), so the init bitfield member and its doc entry were
  dropped and the write guard inserted directly after lock_sock().
  af_alg_sendpage() still bypasses af_alg_sendmsg() here; the
  following cve-bf commit funnels it through, matching the ordering
  used in linux-5.10.y. algif_skcipher's accept kept the pre-rework
  field-by-field init instead of upstream's memset, so ctx->write = 0
  is added there to keep a fresh socket from inheriting a set write
  bit from uninitialized slab memory.

Issuing two writes to the same af_alg socket is bogus as the
data will be interleaved in an unpredictable fashion.  Furthermore,
concurrent writes may create inconsistencies in the internal
socket state.

Disallow this by adding a new ctx->write field that indiciates
exclusive ownership for writing.

Fixes: 8ff590903d5 ("crypto: algif_skcipher - User-space interface for skcipher operations")
	Reported-by: Muhammad Alifa Ramdhan <ramdhan@starlabs.sg>
	Reported-by: Bing-Jhong Billy Jheng <billy@starlabs.sg>
	Signed-off-by: Herbert Xu <herbert@gondor.apana.org.au>
(cherry picked from commit 1b34cbbf4f011a121ef7b2d7d6e6920a036d5285)
	Signed-off-by: Brett Mastbergen <bmastbergen@ciq.com>
---
 crypto/af_alg.c         | 7 +++++++
 crypto/algif_skcipher.c | 1 +
 include/crypto/if_alg.h | 8 +++++---
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/crypto/af_alg.c b/crypto/af_alg.c
index 80dacb1a16da..75d9455fb516 100644
--- a/crypto/af_alg.c
+++ b/crypto/af_alg.c
@@ -833,6 +833,12 @@ int af_alg_sendmsg(struct socket *sock, struct msghdr *msg, size_t size,
 	}
 
 	lock_sock(sk);
+	if (ctx->write) {
+		release_sock(sk);
+		return -EBUSY;
+	}
+	ctx->write = true;
+
 	if (!ctx->more && ctx->used) {
 		err = -EINVAL;
 		goto unlock;
@@ -933,6 +939,7 @@ int af_alg_sendmsg(struct socket *sock, struct msghdr *msg, size_t size,
 
 unlock:
 	af_alg_data_wakeup(sk);
+	ctx->write = false;
 	release_sock(sk);
 
 	return copied ?: err;
diff --git a/crypto/algif_skcipher.c b/crypto/algif_skcipher.c
index bff250433d15..35f78d9fd175 100644
--- a/crypto/algif_skcipher.c
+++ b/crypto/algif_skcipher.c
@@ -367,6 +367,7 @@ static int skcipher_accept_parent_nokey(void *private, struct sock *sk)
 	ctx->more = 0;
 	ctx->merge = 0;
 	ctx->enc = 0;
+	ctx->write = 0;
 	crypto_init_wait(&ctx->wait);
 
 	ask->private = ctx;
diff --git a/include/crypto/if_alg.h b/include/crypto/if_alg.h
index 96933d20f282..9b49a492c706 100644
--- a/include/crypto/if_alg.h
+++ b/include/crypto/if_alg.h
@@ -140,6 +140,7 @@ struct af_alg_async_req {
  *			SG?
  * @enc:		Cryptographic operation to be performed when
  *			recvmsg is invoked.
+ * @write:		True if we are in the middle of a write.
  * @len:		Length of memory allocated for this data structure.
  */
 struct af_alg_ctx {
@@ -153,9 +154,10 @@ struct af_alg_ctx {
 	size_t used;
 	atomic_t rcvused;
 
-	bool more;
-	bool merge;
-	bool enc;
+	u32		more:1,
+			merge:1,
+			enc:1,
+			write:1;
 
 	unsigned int len;
 };
-- 
2.52.0

