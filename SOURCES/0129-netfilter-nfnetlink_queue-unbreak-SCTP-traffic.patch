From 9e24d9ef2fa30c69bf012655b00426c0b6d6d799 Mon Sep 17 00:00:00 2001
From: Brett Mastbergen <bmastbergen@ciq.com>
Date: Mon, 19 Oct 2026 11:07:10 -0400
Subject: [PATCH] netfilter: nfnetlink_queue: unbreak SCTP traffic

jira VULN-221091
cve-pre CVE-2026-99999
commit-author Antonio Ojea <aojea@google.com>
commit 26a77d02891ab62172085a4f94af9b3c90aed387
upstream-diff |
    context diff: this kernel predates the nfnetlink_queue refactor;
    the file is net/netfilter/nfnetlink_queue_core.c here. The commit
    depends on two inline helpers added to include/linux/skbuff.h by
    later upstream commits (skb_is_gso_sctp in d02f51cbcf12b0,
    skb_csum_is_sctp in fa82117010430); both are folded into this
    backport at upstream-adjacent placements, as the remaining hunks
    of those commits (BPF filter.c proto-xlat, documentation,
    ionic driver) do not apply to this kernel. skb_crc32c_csum_help()
    already exists in net/core/dev.c in this kernel (unexported);
    only its EXPORT_SYMBOL is added. In nfnetlink_queue_core.c the
    helper insertion conflicted against functions absent in this
    kernel (nfqnl_put_sk_uidgid &c.) and is placed directly above
    nfqnl_build_packet_message; the COPY_PACKET and enqueue-condition
    hunks apply at their original call sites.

when packet is enqueued with nfqueue and GSO is enabled, checksum
calculation has to take into account the protocol, as SCTP uses a
32 bits CRC checksum.

Enter skb_gso_segment() path in case of SCTP GSO packets because
skb_zerocopy() does not support for GSO_BY_FRAGS.

Joint work with Pablo.

	Signed-off-by: Antonio Ojea <aojea@google.com>
	Signed-off-by: Pablo Neira Ayuso <pablo@netfilter.org>
(cherry picked from commit 26a77d02891ab62172085a4f94af9b3c90aed387)
Signed-off-by: Jonathan Maple <jmaple@ciq.com>
Signed-off-by: Brett Mastbergen <bmastbergen@ciq.com>
---
 include/linux/skbuff.h               | 11 +++++++++++
 net/core/dev.c                       |  1 +
 net/netfilter/nfnetlink_queue_core.c | 12 ++++++++++--
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index 5a20c7f7b043..e2d68c9ce29c 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -3906,6 +3906,12 @@ static inline bool skb_is_gso_v6(const struct sk_buff *skb)
 	return skb_shinfo(skb)->gso_type & SKB_GSO_TCPV6;
 }
 
+/* Note: Should be called only if skb_is_gso(skb) is true */
+static inline bool skb_is_gso_sctp(const struct sk_buff *skb)
+{
+	return skb_shinfo(skb)->gso_type & SKB_GSO_SCTP;
+}
+
 void __skb_warn_lro_forwarding(const struct sk_buff *skb);
 
 static inline bool skb_warn_if_lro(const struct sk_buff *skb)
@@ -4023,5 +4029,10 @@ static inline __wsum lco_csum(struct sk_buff *skb)
 	return csum_partial(l4_hdr, csum_start - l4_hdr, partial);
 }
 
+static inline bool skb_csum_is_sctp(struct sk_buff *skb)
+{
+	return skb->csum_not_inet;
+}
+
 #endif	/* __KERNEL__ */
 #endif	/* _LINUX_SKBUFF_H */
diff --git a/net/core/dev.c b/net/core/dev.c
index b41fdcde32df..5c351ebe25b4 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -2825,6 +2825,7 @@ int skb_crc32c_csum_help(struct sk_buff *skb)
 out:
 	return ret;
 }
+EXPORT_SYMBOL(skb_crc32c_csum_help);
 
 __be16 skb_network_protocol(struct sk_buff *skb, int *depth)
 {
diff --git a/net/netfilter/nfnetlink_queue_core.c b/net/netfilter/nfnetlink_queue_core.c
index ff2d4b31b353..2f042babd9c0 100644
--- a/net/netfilter/nfnetlink_queue_core.c
+++ b/net/netfilter/nfnetlink_queue_core.c
@@ -245,6 +245,14 @@ nfqnl_put_packet_info(struct sk_buff *nlskb, struct sk_buff *packet,
 	return flags ? nla_put_be32(nlskb, NFQA_SKB_INFO, htonl(flags)) : 0;
 }
 
+static int nf_queue_checksum_help(struct sk_buff *entskb)
+{
+	if (skb_csum_is_sctp(entskb))
+		return skb_crc32c_csum_help(entskb);
+
+	return skb_checksum_help(entskb);
+}
+
 static struct sk_buff *
 nfqnl_build_packet_message(struct nfqnl_instance *queue,
 			   struct nf_queue_entry *entry,
@@ -297,7 +305,7 @@ nfqnl_build_packet_message(struct nfqnl_instance *queue,
 	case NFQNL_COPY_PACKET:
 		if (!(queue->flags & NFQA_CFG_F_GSO) &&
 		    entskb->ip_summed == CHECKSUM_PARTIAL &&
-		    skb_checksum_help(entskb))
+		    nf_queue_checksum_help(entskb))
 			return NULL;
 
 		data_len = ACCESS_ONCE(queue->copy_range);
@@ -614,7 +622,7 @@ nfqnl_enqueue_packet(struct nf_queue_entry *entry, unsigned int queuenum)
 		break;
 	}
 
-	if ((queue->flags & NFQA_CFG_F_GSO) || !skb_is_gso(skb))
+	if (!skb_is_gso(skb) || ((queue->flags & NFQA_CFG_F_GSO) && !skb_is_gso_sctp(skb)))
 		return __nfqnl_enqueue_packet(net, queue, entry);
 
 	nf_bridge_adjust_skb_data(skb);
-- 
